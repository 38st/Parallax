            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Esta conversación enlaza a %lld artefacto de Claude. Los artefactos se almacenan en claude.ai bajo la cuenta original y no se abrirán en el espacio de destino.</string>
            <key>other</key>
            <string>Esta conversación enlaza a %lld artefactos de Claude. Los artefactos se almacenan en claude.ai bajo la cuenta original y no se abrirán en el espacio de destino.</string>
